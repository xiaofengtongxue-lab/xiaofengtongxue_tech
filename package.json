{
  "name": "xiaofengtongxue-tech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs --host 0.0.0.0",
    "docs:build": "node scripts/build-published.mjs",
    "docs:build:drafts": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0",
    "docs:check": "node scripts/check-seo.mjs",
    "docs:verify": "npm run content:test && npm run content:check && npm run docs:build && npm run docs:check",
    "content:approve": "node scripts/approve-content.mjs",
    "content:status": "node scripts/content-status.mjs",
    "content:check": "node scripts/content-status.mjs --check",
    "content:test": "node --test scripts/content-revisions.test.mjs",
    "deploy": "bash scripts/deploy.sh",
    "deploy:verify": "node scripts/verify-deployment.mjs --target https://www.xiaofengtongxue.com --base / --canonical https://www.xiaofengtongxue.com --expect-agents-noindex false --expect-agents-sitemap true --check-redirects",
    "seo:submit:baidu": "node scripts/submit-baidu.mjs"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "gray-matter": "^4.0.3",
    "vitepress": "^1.6.4"
  }
}
