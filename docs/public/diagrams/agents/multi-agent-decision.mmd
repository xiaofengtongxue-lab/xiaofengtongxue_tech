%%{init: {"theme":"base","themeCSS":"#container { background-color: #ffffff; }","themeVariables":{"fontFamily":"Arial, sans-serif","primaryColor":"#FFF4EF","primaryBorderColor":"#E65332","primaryTextColor":"#27272A","lineColor":"#71717A","secondaryColor":"#EEF5FF","tertiaryColor":"#F4F4F5"}}}%%
flowchart TD
  S["先做单 Agent 基线<br/>记录完成率、延迟、成本和失败样例"] --> B{"失败是否来自可证明的拆分需求？"}
  B -->|"没有，只是 Prompt 或工具设计差"| FIX["修工具、状态、上下文和评测"]
  FIX --> S
  B -->|"不同任务需要隔离的指令或工具"| ROUTE["Router / Handoff"]
  B -->|"同类独立任务可以并行"| WORKER["Orchestrator-Workers"]
  B -->|"需要独立候选和裁判"| JUDGE["Evaluator / Competition"]
  B -->|"阶段边界固定、责任不同"| PIPE["Pipeline"]
  ROUTE & WORKER & JUDGE & PIPE --> CONTRACT["给每个 Agent 定义<br/>输入、输出、预算、权限、停止和失败传播"]
  CONTRACT --> EVAL["与单 Agent 基线做同集评测"]
  EVAL --> WIN{"收益大于协调成本吗？"}
  WIN -->|"否"| S
  WIN -->|"是"| ADOPT["保留最小必要的多 Agent 结构"]

  classDef baseline fill:#FFF4EF,stroke:#E65332,color:#27272A,stroke-width:2px;
  classDef decision fill:#FFF8DB,stroke:#B7791F,color:#27272A,stroke-width:2px;
  classDef pattern fill:#EEF5FF,stroke:#3973B7,color:#27272A;
  classDef done fill:#EAF7EE,stroke:#2F855A,color:#27272A;
  class S baseline;
  class B,WIN decision;
  class FIX,ROUTE,WORKER,JUDGE,PIPE,CONTRACT,EVAL pattern;
  class ADOPT done;
