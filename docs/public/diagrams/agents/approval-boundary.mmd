%%{init: {"theme":"base","themeCSS":"#container { background-color: #ffffff; }","themeVariables":{"fontFamily":"Arial, sans-serif","primaryColor":"#FFF4EF","primaryBorderColor":"#E65332","primaryTextColor":"#27272A","lineColor":"#71717A","secondaryColor":"#EEF5FF","tertiaryColor":"#F4F4F5"}}}%%
flowchart TD
  C["模型提出工具调用"] --> P["应用层重新校验<br/>身份、范围、参数、当前状态"]
  P --> R{"动作风险"}
  R -->|"只读"| RO["在沙箱内执行"]
  R -->|"仅写受限草稿区"| DR["执行并记录审计"]
  R -->|"删除、发送、付款、正式发布"| PRE["生成待确认动作<br/>真实参数 + 影响 + 过期时间 + Hash"]
  PRE --> H{"授权人确认了吗？"}
  H -->|"拒绝 / 超时"| STOP["取消，不产生副作用"]
  H -->|"批准"| RECHECK["执行前重新校验<br/>参数和权限是否仍一致"]
  RECHECK -->|"不一致"| EXPIRE["旧确认失效，重新申请"]
  RECHECK -->|"一致"| IDEM["带幂等键执行"]
  RO --> LOG["记录结果和证据"]
  DR --> LOG
  IDEM --> LOG

  classDef safe fill:#EAF7EE,stroke:#2F855A,color:#27272A;
  classDef guard fill:#FFF8DB,stroke:#B7791F,color:#27272A,stroke-width:2px;
  classDef risk fill:#FFF4EF,stroke:#E65332,color:#27272A,stroke-width:2px;
  classDef normal fill:#EEF5FF,stroke:#3973B7,color:#27272A;
  class RO,DR,LOG safe;
  class R,H,RECHECK guard;
  class PRE,STOP,EXPIRE risk;
  class C,P,IDEM normal;
